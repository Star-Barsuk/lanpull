# lanpull systemd unit.
#
# Installed by `make install`, which substitutes the placeholders below with
# the operator user and group, the installed binary path, the configuration
# path, and the state directory. The unit does NOT autostart on boot and has no
# [Install] section: the operator starts it explicitly for an update round with
# `lanpull service start`.

[Unit]
Description=lanpull file-distribution server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__LANPULL_USER__
Group=__LANPULL_GROUP__
ExecStart=__LANPULL_BIN__ serve --config __LANPULL_CONF__
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# Hardening: the service needs read access to the share and write access to the
# state directory only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__LANPULL_STATE_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# A port below 1024 would need CAP_NET_BIND_SERVICE here; the default 8000 needs none.
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
RemoveIPC=true
