# lanpull server configuration.
# Copy to config/lanpull.conf and adjust. The real file is not committed and
# must be readable only by its owner (mode 600).

# Directory holding the files to distribute. Can be any path, outside the
# project. The manifest is NOT written here; it lives under STATE_DIR.
SHARE_DIR=/srv/lanpull/share

# Internal state (manifest, hash cache, TLS material, arm state, audit log).
# Must be OUTSIDE SHARE_DIR so it is never treated as share content. The server
# user needs write access.
STATE_DIR=/var/lib/lanpull

# Address and port the server listens on. Listen on all interfaces and restrict
# access with the host firewall: the share is meant for the LAN only.
BIND=0.0.0.0
PORT=8000

# The address clients use to reach the server. Must match the static IP (or
# DHCP reservation) and is embedded in the certificate SAN as IP:<server-ip>.
SERVER_IP=<server-ip>

# TLS material generated by `make cert` (lanpull cert). The key must be mode 600.
CERT_PATH=/var/lib/lanpull/server.crt
KEY_PATH=/var/lib/lanpull/server.key

# Per-client accounts: one "user:argon2hash[:allowed_ip]" line per machine.
# The optional third field binds the account to a source IP; omit it (or use
# "*") to accept the account from any address on the LAN (access is then gated
# by the password and the arm window). Managed by `make add-client` /
# `remove-client` / `passwd`; mode 600; never committed. Authentication is
# mandatory, so the server refuses to start when this file is missing or empty.
# Relative paths are resolved against the directory of this config file.
CLIENTS_PATH=lanpull.clients

# Audit log written by `lanpull serve` (one JSON line per request). Read by
# `make report`.
AUDIT_LOG=/var/lib/lanpull/access.log
