# lanpull server configuration template.
# The real file is /etc/lanpull/lanpull.conf; create it with `sudo lanpull init`
# (which fills in this machine's values), or copy this template and adjust by
# hand. It is never committed; the service reads it via `root:<group>` mode 640.

# One SHARE_<name>=<path> key per share; at least one is required. The name
# matches ^[a-z0-9][a-z0-9_-]*$ and is the share identity used by clients and
# by the access policy. A share can be any path outside the project. Manifests
# are NOT written here; they live under STATE_DIR.
SHARE_default=/srv/lanpull/share

# Internal state (manifest, hash cache, TLS material, arm state, audit log).
# Must be OUTSIDE every share root so it is never treated as share content. The
# server user needs write access.
STATE_DIR=/var/lib/lanpull

# Address and port the server listens on. Listen on all interfaces and restrict
# access with the host firewall: the share is meant for the LAN only.
BIND=0.0.0.0
PORT=8000

# The address clients use to reach the server. Must match the static IP (or
# DHCP reservation) and is embedded in the certificate SAN as IP:<server-ip>.
SERVER_IP=<server-ip>

# TLS material generated by `lanpull cert`. The key must be mode 600.
CERT_PATH=/var/lib/lanpull/server.crt
KEY_PATH=/var/lib/lanpull/server.key

# Per-client accounts: one "user:argon2hash[:allowed_ip][:local]" line per
# machine. The optional third field binds the account to a source IP; omit it
# (or use "*") to accept the account from any address on the LAN (access is then
# gated by the password and the arm window). A trailing "local" marks a
# self-share account, exempt from the arm window. Managed by `lanpull account
# add` / `remove` / `passwd`; mode 600; never committed. Authentication is
# mandatory, so the server refuses to start when this file is missing or empty.
# Relative paths are resolved against the directory of this config file.
CLIENTS_PATH=lanpull.clients

# Access policy: JSON mapping each share to a public file set plus per-account
# additions and removals. Managed by `lanpull access`; mode 600; never
# committed. Relative paths are resolved against the directory of this config.
ACCESS_PATH=lanpull.access.json

# Audit log written by `lanpull serve` (one JSON line per request). Read by
# `lanpull report`.
AUDIT_LOG=/var/lib/lanpull/access.log
